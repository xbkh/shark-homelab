# Login password for the Shark web UI
SHARK_PASSWORD=change-me
# Long random string used to sign session cookies (python3 -c "import secrets;print(secrets.token_hex(32))")
SHARK_SECRET=long-random-string
# Optional: NetBird personal access token, to list your VPN peers in the UI
NETBIRD_API_TOKEN=
# Optional: secret ntfy topic for push alerts (e.g. shark-<random>)
NTFY_TOPIC=
# Optional: Healthchecks.io ping URL (dead man's switch, pinged every minute)
HEALTHCHECK_URL=
# Optional: host folder holding the backup snapshots shown in the Cloud page (read-only)
BACKUPS_DIR=
